{
  "name": "page-demos",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"const f=require('fs');f.mkdirSync('public/litert-wasm',{recursive:true});for(const v of['litert_wasm_internal','litert_wasm_threaded_internal','litert_wasm_compat_internal'])for(const e of['js','wasm'])f.copyFileSync('node_modules/@litertjs/core/wasm/'+v+'.'+e,'public/litert-wasm/'+v+'.'+e);f.copyFileSync('node_modules/coi-serviceworker/coi-serviceworker.min.js','public/coi-serviceworker.min.js')\"",
    "dev": "vite",
    "build": "vite build",
    "build:all": "vite build && npm --prefix matcha-tts run build && node -e \"const f=require('fs');f.cpSync('matcha-tts/dist','dist/matcha-tts',{recursive:true});f.rmSync('dist/matcha-tts/litert-wasm',{recursive:true})\"",
    "preview": "vite preview",
    "deploy": "npm run build:all && gh-pages -d dist"
  },
  "dependencies": {
    "@litertjs/core": "^2.5.3",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "coi-serviceworker": "^0.1.7",
    "gh-pages": "^6.3.0",
    "vite": "^6.0.0"
  }
}
